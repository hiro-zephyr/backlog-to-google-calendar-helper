{
  "manifest_version": 3,
  "name": "Backlog to Google Calendar Helper",
  "version": "0.4.5",
  "description": "Prepare Backlog issue text for Google Calendar or Google Tasks.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.backlog.com/*",
    "https://*.backlog.jp/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Backlog → Google Calendar"
  },
  "commands": {
    "open-backlog-to-gcal": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Backlog課題をGoogleカレンダー予定として準備して開く"
    },
    "open-backlog-to-gtask": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Backlog課題をGoogle ToDoとして準備して開く"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.backlog.com/view/*",
        "https://*.backlog.jp/view/*"
      ],
      "js": [
        "content-backlog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "content-calendar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}